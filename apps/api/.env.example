NODE_ENV=development
# Used only by the local Node server. Vercel Functions do not need a port.
PORT=3000
# In production, set this to the exact deployed frontend origin (no trailing slash).
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_MEMBERS_TABLE=members
SUPABASE_ADMIN_USERS_TABLE=admin_users
